{
	"name": "FINAL_ETL",
	"properties": {
		"activities": [
			{
				"name": "Truncate_Staging",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "BEGIN\nIF OBJECT_ID('stg.salesorderheader', 'U') IS NOT NULL\n TRUNCATE TABLE stg.salesorderheader;\nIF OBJECT_ID('stg.salesorderdetail', 'U') IS NOT NULL\n TRUNCATE TABLE stg.salesorderdetail;\nIF OBJECT_ID('stg.customer', 'U') IS NOT NULL\n TRUNCATE TABLE stg.customer;\nIF OBJECT_ID('stg.person', 'U') IS NOT NULL\n TRUNCATE TABLE stg.person;\nIF OBJECT_ID('stg.product', 'U') IS NOT NULL\n TRUNCATE TABLE stg.product;\nIF OBJECT_ID('stg.productsubcategory', 'U') IS NOT NULL\n TRUNCATE TABLE stg.productsubcategory;\nIF OBJECT_ID('stg.productcategory', 'U') IS NOT NULL\n TRUNCATE TABLE stg.productcategory;\nIF OBJECT_ID('stg.salesterritory', 'U') IS NOT NULL\n TRUNCATE TABLE stg.salesterritory;\nIF OBJECT_ID('stg.store', 'U') IS NOT NULL\n TRUNCATE TABLE stg.store;\nEND"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "SELECT_TABLES FROM_OLTP",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Truncate_Staging",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n t.TABLE_SCHEMA AS schema_name,\n t.TABLE_NAME AS table_name\nFROM INFORMATION_SCHEMA.TABLES t\nWHERE TABLE_TYPE = 'BASE TABLE'\n AND (t.TABLE_SCHEMA + '.' + t.TABLE_NAME) IN (\n 'Sales.SalesOrderDetail',\n 'Sales.Customer',\n 'Person.Person',\n 'Sales.Store',\n 'Production.Product',\n 'Production.ProductCategory',\n 'Sales.SalesTerritory'\n )\nORDER BY t.TABLE_SCHEMA, t.TABLE_NAME;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Loop_OLTOP",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "SELECT_TABLES FROM_OLTP",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('SELECT_TABLES FROM_OLTP').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_OLTP_Tables",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "AzureSqlTable1",
									"type": "DatasetReference",
									"parameters": {
										"schema": "@item().schema_name",
										"table": {
											"value": "@item().table_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "AzureSqlTable2",
									"type": "DatasetReference",
									"parameters": {
										"schema": "stg",
										"table": {
											"value": "@item().table_name",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": []
	}
}